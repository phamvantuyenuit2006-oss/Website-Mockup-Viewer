{
  "name": "website-mockup-viewer",
  "version": "1.0.0",
  "description": "Local Website Mockup Viewer using Playwright and React",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "tsx server/index.ts",
    "build": "npm run client:build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "vite",
    "client:build": "tsc -b && vite build",
    "electron:dev": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"blue,green,magenta\" \"npm run server:dev\" \"npm run client:dev\" \"tsx electron/wait-and-start.ts\"",
    "electron:build": "npm run client:build && tsc -p electron/tsconfig.json && electron-builder",
    "typecheck": "tsc --noEmit",
    "playwright:install": "npx playwright install chromium"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.475.0",
    "playwright": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
